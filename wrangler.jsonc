// Cloudflare Workers static-assets config — serves this folder as a static site.
// `name` must match the Worker in the Cloudflare dashboard.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pantone3d",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./"
  }
}
